FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

WORKDIR /app

# requirements-api.txt is the tracked source of truth for the API's runtime
# deps. This previously COPYed config/requirements.txt, which was retired in an
# earlier release and is gitignored — so the build failed on every clean
# checkout with `"/config/requirements.txt": not found` and `make test` was
# dead. Keep this path pointing at a TRACKED file.
#
# MetaTrader5 is a Windows-only wheel — strip it and let tests/conftest.py
# inject a stub at import time.
#
# requirements-mcpunifier.txt is installed beside it because
# tests/test_mcp_chartctl_tools.py drives the unified MCP server in-process.
# Both pin the same mcp SDK (tests/test_requirements_sync.py checks that).
#
# pytest runs the suite. requests is what tests/live/ (`make test-live`, which
# runs in this same image) talks to the target stack with.
COPY requirements-api.txt requirements-mcpunifier.txt /tmp/
RUN grep -v -i '^MetaTrader5' /tmp/requirements-api.txt > /tmp/req-test.txt && \
    pip install --no-cache-dir -r /tmp/req-test.txt -r /tmp/requirements-mcpunifier.txt \
        pytest==9.1.1 requests==2.34.2 pytest-cov==7.1.0

COPY mt5api ./mt5api
COPY mcpunifier ./mcpunifier
COPY tests ./tests
# Tests inspect the tracked dependency manifests and the Windows installer.
# Copy only the required scripts rather than pulling every installer asset in.
# docker-compose.yml.j2 is here because the compose-generation test renders the
# REAL template — a stub would assert nothing about what actually ships.
COPY requirements-api.txt requirements-mcpunifier.txt requirements-test.txt docker-compose.yml.example docker-compose.yml.j2 run.sh ./
COPY scripts/config_helper.py \
    scripts/start.bat \
    scripts/install.bat \
    scripts/check_health.py \
    scripts/desktop_heap.py \
    scripts/reboot_guard.py \
    scripts/healthcheck.sh \
    scripts/rotate-logs.sh \
    scripts/verify_binaries.py \
    scripts/wickworks-healthcheck.py \
    scripts/vm-watchdog.py \
    scripts/recreate-vm.sh \
    scripts/webrequest_allowlist_codec.py \
    ./scripts/
COPY assets/binaries.lock.json ./assets/

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1

# tests/live/ drives a RUNNING deployment over HTTP. It needs a reachable target
# and real broker credentials, so it runs only through `make test-live`.
#
# tests/integration/ spawns sibling containers via testcontainers and the host
# docker socket, neither of which exists in here. `make test-integration` runs
# it on the host instead.
#
# Everything under tests/ outside those dirs is offline-safe.
#
# --cov=mt5api scopes coverage to the API package only — scripts/ is
# subprocess-driven (would misreport). mcpunifier has unit tests here too, but
# its coverage is not measured against this floor. Measured TOTAL on 2026-08-06 was 64%; floor is
# set 2 points below that (rounded down) as a regression gate, not a target.
# Raise this floor as coverage grows — never lower it to make a red build pass.
CMD ["pytest", "-v", "--tb=short", "--ignore=tests/live", "--ignore=tests/integration", "--cov=mt5api", "--cov-report=term-missing:skip-covered", "--cov-fail-under=62", "tests/"]
